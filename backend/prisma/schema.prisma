generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  DRIVER
  ADMIN
}

enum LoadStatus {
  OPEN
  BOOKED
  IN_TRANSIT
  DELIVERED
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum EscrowStatus {
  UNPAID
  FUNDS_SECURED
  RELEASED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocType {
  AADHAAR
  DRIVING_LICENSE
}

enum PaymentStatus {
  PENDING
  COLLECTED
  RELEASED
  DISPUTED
}

enum SosStatus {
  OPEN
  RESOLVED
}

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  passwordHash  String
  role          Role
  isKycVerified Boolean    @default(false)
  kycStatus     KycStatus  @default(PENDING)
  aadhaarNumber String    @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  loadPosts       LoadPost[]    @relation("CustomerLoads")
  bids            Bid[]         @relation("DriverBids")
  trips           Trip[]        @relation("DriverTrips")
  reviewsGiven    Review[]      @relation("ReviewsGiven")
  reviewsReceived Review[]      @relation("ReviewsReceived")
  sosAlerts       SosAlert[]    @relation("SosAlerts")
  kycDocuments    KycDocument[] @relation("UserKycDocs")

  @@map("users")
}

model KycDocument {
  id           String   @id @default(uuid())
  userId       String
  documentType DocType
  filePath     String
  uploadedAt   DateTime @default(now())

  user         User     @relation("UserKycDocs", fields: [userId], references: [id])

  @@map("kyc_documents")
}

model LoadPost {
  id                String     @id @default(uuid())
  customerId        String
  origin            String
  destination       String
  requiredVehicle   String
  estimatedWeightKg Float
  status            LoadStatus @default(OPEN)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  customer          User       @relation("CustomerLoads", fields: [customerId], references: [id])
  bids              Bid[]
  trip              Trip?

  @@map("load_posts")
}

model Bid {
  id           String       @id @default(uuid())
  postId       String
  driverId     String
  amount       Float
  message      String?      @db.Text
  status       BidStatus    @default(PENDING)
  escrowStatus EscrowStatus @default(UNPAID)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  post         LoadPost     @relation(fields: [postId], references: [id])
  driver       User         @relation("DriverBids", fields: [driverId], references: [id])
  payment      Payment?

  @@map("bids")
}

model Trip {
  id              String    @id @default(uuid())
  postId          String    @unique
  driverId        String
  currentLocation String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  post            LoadPost  @relation(fields: [postId], references: [id])
  driver          User      @relation("DriverTrips", fields: [driverId], references: [id])
  reviews         Review[]
  sosAlerts       SosAlert[]

  @@map("trips")
}

model Review {
  id              String   @id @default(uuid())
  tripId          String
  reviewerId      String
  revieweeId      String
  rating          Int
  comment         String?  @db.Text
  speedScore      Int?
  handlingScore   Int?
  routeScore      Int?
  createdAt       DateTime @default(now())

  trip            Trip     @relation(fields: [tripId], references: [id])
  reviewer        User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee        User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@unique([tripId, reviewerId])
  @@map("reviews")
}

model SosAlert {
  id              String    @id @default(uuid())
  tripId          String
  raisedById      String
  status          SosStatus @default(OPEN)
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  trip            Trip      @relation(fields: [tripId], references: [id])
  raisedBy        User      @relation("SosAlerts", fields: [raisedById], references: [id])

  @@map("sos_alerts")
}

model Payment {
  id            String        @id @default(uuid())
  bidId         String        @unique
  amount        Float
  platformFee   Float
  driverPayout  Float
  status        PaymentStatus @default(PENDING)
  collectedAt   DateTime?
  releasedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  bid           Bid           @relation(fields: [bidId], references: [id])

  @@map("payments")
}
